# ==============================
# Unity Git LFS & line endings
# ==============================

# Auto detect text files
* text=auto

# Force LF for source files
*.cs        text eol=crlf
*.js        text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.glsl      text eol=lf
*.compute   text eol=lf
*.asmdef    text eol=lf

# Unity text assets (YAML)
*.unity     merge=unityyamlmerge eol=lf
*.prefab    merge=unityyamlmerge eol=lf
*.asset     merge=unityyamlmerge eol=lf
*.mat       merge=unityyamlmerge eol=lf
*.meta      merge=unityyamlmerge eol=lf
*.anim      merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf

# Binary files (never diff, never merge)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.tga       binary
*.tif       binary
*.tiff      binary
*.psd       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.aiff      binary
*.flac      binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.dae       binary
*.glb       binary
*.gltf      binary
*.dll       binary
*.exe       binary
*.zip       binary
*.7z        binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
